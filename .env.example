# Copy to .env (git-ignored) and fill in the keys for what you use. Every key is optional: a feature
# whose key is missing says so on its page, and `pnpm run doctor` lists what is set. Your own settings
# that are not secrets go in ~/.studio-engine/config.json (see config.example.json).

# Claude. Every `claude` run uses your claude.ai plan login (Settings > Claude plan only, on by
# default), and a key put here is ignored. Turn that switch off (or set STUDIO_CLAUDE_PLAN_ONLY=0)
# to bill the API with this key instead; only `claude` runs get it, never a script.
# https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=

# ElevenLabs: transcripts, voiceovers and made-for-the-video music. This one key goes in the
# video-use skill's own file, ~/Developer/video-use/.env, not here. `pnpm run doctor` checks it.
# https://elevenlabs.io/app/settings/api-keys
# ELEVENLABS_API_KEY=

# Apify: reading the song of an Instagram or TikTok link, trending sounds, and each client's weekly
# Instagram scan (Clients x Instagram; STUDIO_INSTAGRAM=0 turns it off). Only the engine reads it,
# never a `claude` run. https://console.apify.com/settings/integrations
APIFY_TOKEN=

# Higgsfield: the shots of a generated video, one with no footage (STUDIO_GENERATE=0 turns it off).
# It spends real money from your prepaid balance. Only the engine's shots script reads it.
HIGGSFIELD_API_KEY=

# Stock media (off by default; "stock": true in config.json or STUDIO_STOCK=1): sound effects and
# photos fetched by the stock script when an edit has none. The Unsplash access key is for photos.
# The Openverse id and secret are optional: without them it answers as an anonymous application with
# low limits. Only the stock script reads them. https://unsplash.com/developers
# https://api.openverse.org/v1/#section/Register-and-Authenticate
UNSPLASH_ACCESS_KEY=
OPENVERSE_CLIENT_ID=
OPENVERSE_CLIENT_SECRET=

# Instagram DMs page: the key of your studio's Instagram account, from Meta's API setup (the page
# walks you through making it). Whose DMs are kept is `instagramDmFrom` in config.json.
INSTAGRAM_DM_TOKEN=
