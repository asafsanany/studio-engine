    "busboy": "^1.6.0",
    "chokidar": "^4.0.3",
    "drizzle-orm": "^0.45.4",
    "execa": "^10.2.0",
    "hono": "^4.13.13",
    "pino": "^10.4.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/busboy": "^1.5.5",
    "@types/node": "^22.20.5",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
